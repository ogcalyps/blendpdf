# Every setting here is optional. With none of them set, the app runs and
# every browser tool works; the server tools also need the programs from
# scripts/provision-server.sh. Copy this file to .env.local and fill in only
# what you use.

# --- Site ---------------------------------------------------------------
# Absolute URLs in the sitemap, canonical links and emails. Default: https://blendpdf.com
NEXT_PUBLIC_SITE_URL=
# Product name in emails. Default: BlendPDF
NEXT_PUBLIC_SITE_NAME=
EMAIL_BRAND_NAME=

# --- Analytics (off when empty) -------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# --- AWS credentials --------------------------------------------------------
# Only needed outside AWS. On an EC2 instance, the instance role is used.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Sending a finished file by email (Amazon SES) --------------------------
# Without a sender, the email option answers that email isn't set up.
AWS_SES_FROM_EMAIL=
AWS_SES_REGION=
AWS_SES_REPLY_TO=
AWS_SES_CONFIGURATION_SET=
# Signs unsubscribe links. Required in production if email is on.
UNSUBSCRIBE_SECRET=

# --- Mailing list (DynamoDB) ------------------------------------------------
# Table for opted-in addresses. Default: blendpdf-emails
AWS_DYNAMODB_EMAILS_TABLE=

# --- Large merges through S3 (legacy path, unused by the current UI) ------
AWS_S3_BUCKET_NAME=

# --- Trustpilot -------------------------------------------------------------
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
NEXT_PUBLIC_TRUSTPILOT_DOMAIN=
# Your Automatic Feedback Service address; review invites are off when empty.
TRUSTPILOT_AFS_EMAIL=

# --- Logging ----------------------------------------------------------------
# Production sends logs to CloudWatch unless this is "false".
ENABLE_CLOUDWATCH_LOGS=false
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=
